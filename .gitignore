# Секрети (правило git-security.md / Golden Rule #7)
*.keystore
*.jks
keystore.properties

# Файли ліцензії Unity та службові логи
*.alf
*.ulf
create_alf.log

# Тимчасові файли Office
~$*

# Службові файли пакета com.unity.test-framework.performance (створюються під час збірки)
/Assets/Resources/PerformanceTestRun*.json
/Assets/Resources/PerformanceTestRun*.json.meta

# Скрипти game-ci, які копіюються в проєкт під час збірки (не файли проєкту)
/Assets/Editor/
/Assets/Editor.meta

# Сцени каркаса генеруються Editor-скриптом перед збіркою (E0-05), не комітяться
/Assets/_Project/Generated/
/Assets/_Project/Generated.meta
/Assets/UI Toolkit/
/Assets/UI Toolkit.meta
