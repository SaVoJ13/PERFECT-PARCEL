/* KEBAB STREET theme (S1-12). Palette: docs/design/ART_STYLE_GUIDE.md section 2. Connected to the root by ArtLibrary.ApplyTheme (UiFactory.Screen). */
:root {
    --ks-cream: rgb(255, 243, 214);
    --ks-sand: rgb(247, 226, 176);
    --ks-espresso: rgb(59, 35, 20);
    --ks-cocoa: rgb(107, 70, 48);
    --ks-saffron: rgb(255, 183, 3);
    --ks-chili: rgb(194, 65, 12);
    --ks-mint: rgb(46, 158, 79);
    --ks-amber: rgb(245, 158, 11);
    --ks-ember: rgb(214, 40, 40);
    --ks-plum: rgb(43, 27, 46);
    /* Q-06: Nunito (SIL OFL 1.1), static instances of the Google Fonts variable file: Regular 400 and ExtraBold 800.
       Latin, Latin Extended (Polish), Cyrillic (Ukrainian). The star glyph is NOT in the font: never put it in text, use icon_star_*. */
}

.ks-root {
    color: var(--ks-cream);
    font-size: 34px;
    -unity-font-definition: url("../../Art/Fonts/Nunito-Regular.ttf");
}

.ks-screen {
    background-color: var(--ks-plum);
}

.ks-bold {
    -unity-font-definition: url("../../Art/Fonts/Nunito-ExtraBold.ttf");
    -unity-font-style: normal;
}

.ks-title {
    color: var(--ks-saffron);
    -unity-font-definition: url("../../Art/Fonts/Nunito-ExtraBold.ttf");
    -unity-font-style: normal;
}

.ks-button {
    background-color: var(--ks-saffron);
    color: var(--ks-espresso);
    -unity-font-definition: url("../../Art/Fonts/Nunito-ExtraBold.ttf");
    -unity-font-style: normal;
    border-radius: 20px;
    border-width: 4px;
    border-color: var(--ks-espresso);
    border-bottom-width: 10px;
    min-height: 144px;
}

/* Q-05a (G-01, QB-ALL-02): spring press: 70 ms down, 150 ms back with overshoot. Only scale/translate, no layout changes (QB-ALL-16). */
.ks-press {
    transition-property: scale, translate;
    transition-duration: 150ms, 150ms;
    transition-timing-function: ease-out-back, ease-out-back;
}

.ks-press:active {
    scale: 0.94 0.94;
    translate: 0 4px;
    transition-duration: 70ms, 70ms;
    transition-timing-function: ease-out, ease-out;
}

.ks-panel {
    background-color: var(--ks-sand);
    color: var(--ks-espresso);
    border-radius: 24px;
    border-width: 4px;
    border-color: var(--ks-espresso);
}

.ks-icon {
    background-size: contain;
}
